{
  "name": "adhan-app",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first azan clock PWA for an always-on iPad kiosk (iPadOS 15+).",
  "license": "MIT",
  "type": "module",
  "browserslist": [
    "iOS >= 15.6"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run --project 'core*' --project dom",
    "test:coverage": "vitest run --project 'core*' --project dom --coverage",
    "test:ui": "vitest --ui",
    "test:build": "vitest run --project build",
    "bench": "vitest bench --run --project 'dom (bench)' --silent=false",
    "check:fast": "npm run typecheck && npm run lint",
    "check:task": "npm run check:fast && npm run test:coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:build",
    "floor-guard": "node scripts/floor-guard.mjs"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "idb-keyval": "^6.3.0",
    "lucide": "^1.73.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "browserslist": "^4.29.5",
    "eslint": "^10.15.0",
    "eslint-plugin-compat": "^7.0.2",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
